#Alpine (OS) with node npm
FROM node:22.23.4-alpine3.24 AS build

#Has app dir
WORKDIR /app

#Copy package lock
COPY package.json package-lock.json ./
#Install
RUN test "$(node --version)" = "v22.23.4" && npm ci

#Copy frontend code
COPY . .

#Build frontend code
RUN npm run build


#
FROM caddy:2-alpine

ENV SITE_ADDRESS=:80

COPY Caddyfile /etc/caddy/Caddyfile

#Coppy /app/dist to /srv (serving)
COPY --from=build /app/dist /srv

EXPOSE 80
