# ---------------------------------------------------------
# Caddy
# ---------------------------------------------------------

# Caddy listens on port 80 inside its container.
# Our Docker Compose maps laptop port 8080 -> Caddy port 80.
SITE_ADDRESS=:80


# ---------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------

# Name of the database PostgreSQL creates.
POSTGRES_DB=equationgolf

# PostgreSQL username.
POSTGRES_USER=equationgolf

# Example only. NEVER put the real password in this example file.
POSTGRES_PASSWORD=replace-me


# ---------------------------------------------------------
# FastAPI session
# ---------------------------------------------------------

# Used by FastAPI to cryptographically sign login session cookies.
# Production requires at least 32 characters.
SESSION_SECRET=replace-me-with-a-long-random-secret


# ---------------------------------------------------------
# Google OAuth
# ---------------------------------------------------------

# We can leave these blank for our first Docker smoke test.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=


# ---------------------------------------------------------
# Public URLs
# ---------------------------------------------------------

# IMPORTANT:
# These are the URLs the BROWSER sees.
#
# We are accessing Caddy through localhost:8080,
# therefore the public origin includes :8080.
FRONTEND_URL=http://localhost:8080
BACKEND_URL=http://localhost:8080